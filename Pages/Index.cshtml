@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
} 
<!-- One  (just the button-->
<section id="one">
	<div class="container">
		<div class="content">
			<ul class="actions special">
				<li><a href="#two" class="button primary scrolly">Learn More</a></li> 
			</ul>
		</div>
	</div> 
</section>

<!-- two -->
<section id="two" class="main special">
	<div class="container">
		<span class="image fit primary"><img src="images/shadow.jpg" alt="" /></span>
		<div class="content">
			<header class="major">
				<h2>Independent Flight Instruction in South Florida</h2>
			</header>
			<div class="col-6 col-12-medium">
				<h5>Independent Part 61 training offers</h5>
				<ul>
					<li>Progress at your own rate</li>
					<li>Checkrides with DPEs that your instructor used</li>
					<li>Savings of up to 40% over part 141 flight schools</li>
				</ul>			
			</div>	
			<p>Instruction based out of Fort Lauderdale Executive and Pompano Airpark</p>
			<iframe src="https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d57267.48882197318!2d-80.1610227846088!3d26.222103609183993!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1sairports!5e0!3m2!1sen!2sus!4v1755390187128!5m2!1sen!2sus"  style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
		</div>
		<a href="#three" class="goto-next scrolly">Next</a>
	</div>
</section>
<!-- three -->
<section id="three" class="main special">
	<div class="container">
		<span class="image fit primary"><img src="images/flysunset.jpg" alt="" /></span>
		<div class="content">
			<header class="major">
				<h2>New Student Special!</h2>
			</header>
			<p>New students get 5 hours of free flight instruction once they have completed an initial 5 hours of training.<br />(plane not included)</p>
		</div>
		<a href="#four" class="goto-next scrolly">Next</a>
	</div>
</section>

<!-- four -->
<section id="four" class="main special">
	<div class="container">
		<span class="image fit primary"><img src="images/nightcity.jpg" alt="" /></span>
		<div class="content">
			<header class="major">
				<h2>Stuff we do</h2>
			</header>
			<h3>Introductory Flight</h3><h3> - $180</h3>
			<p>~45 minute discovery flight. Includes aircraft and fuel</p>
			<ul class="icons-grid">
				<li>
					<span class="icon solid major fa fa-plane"></span>
					<h3>Private Pilot Instruction</h3>
				</li>
				<li>
					<span class="icon solid major fa fa-plane"></span>
					<h3>Commercial Pilot Instruction</h3>
				</li>
				<li>
					<span class="icon solid major fa fa-plane"></span>
					<h3>Flight Reviews</h3>
				</li>
				<li>
					<span class="icon solid major fa fa-plane"></span>
					<h3>Ferry Pilot</h3>
				</li>
			</ul>			
			<h5>Instruction Rates</h5>
			<ul class="alt">
				<li>$40 - hour flight instruction</li>
				<li>$40 - hour ground instruction</li>
				<li>$50 bi-annual flight review</li>
			</ul>
			<p>Ferry Pilot Rates as low as $50 - day plus expenses. Contact us for details.</p>
			<p>Rates do not include aircraft. <br/>Aircraft rates are approximately $165 - hr including fuel.</p>
			
		</div>
		<a href="#five" class="goto-next scrolly">Next</a>
	</div>
</section>
<!----- five -----></>
<section id="five" class="main special">
	<div class="container">
		<span class="image fit primary"><img src="images/flysunset.jpg" alt="" /></span>
		<div class="content">
			<p>More Information</p>
			<a href="whyus" class="button fit small">Details</a>
		</div>
		<a href="#footer" class="goto-next scrolly">Next</a>
	</div>
</section>


